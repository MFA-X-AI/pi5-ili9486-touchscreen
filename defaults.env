# Defaults for 3.5" ILI9486 + XPT2046/ADS7846 SPI panels (480x320).
# Values were verified on an MHS35 unit. Override before running setup.sh,
# or edit in place.
# SPI clock for the panel. 32 MHz is stable on the MHS35; some clones need less.
PANEL_SPEED=32000000

# Panel-level rotation passed to the piscreen overlay (0/90/180/270).
PANEL_ROTATE=90

# DRM connector name the panel appears as. piscreen on SPI0 => SPI-1.
OUTPUT_NAME=SPI-1

# Compositor-level rotation applied via wlr-randr (0/90/180/270).
# With PANEL_ROTATE=90 and a portrait-mounted panel, 270 gives landscape.
OUTPUT_TRANSFORM=270

# UI scale. 0.75 fits more on the 480x320 panel; 1 is easier to tap.
OUTPUT_SCALE=0.75

# libinput calibration matrix measured on one MHS35 unit (4-corner method).
# Resistive panels vary — run steps/03-calibrate-touch.sh to measure your own.
CAL_MATRIX="1.08696 0 -0.04348 0 1.11111 -0.05556"
