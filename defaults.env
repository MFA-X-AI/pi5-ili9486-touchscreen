# Defaults for 3.5" ILI9486 + XPT2046/ADS7846 SPI panels (480x320).
# Values were verified on an MHS35 unit. Override before running setup.sh,
# or edit in place.
# SPI clock for the panel. 32 MHz is stable on the MHS35; some clones need less.
PANEL_SPEED=32000000

# Panel-level rotation passed to the piscreen overlay (0/90/180/270).
PANEL_ROTATE=90

# DRM connector name the panel appears as. piscreen on SPI0 => SPI-1.
OUTPUT_NAME=SPI-1

# Compositor-level rotation applied via wlr-randr (0/90/180/270).
# With PANEL_ROTATE=90 and a portrait-mounted panel, 270 gives landscape.
OUTPUT_TRANSFORM=270

# Output mode with a real refresh rate. The ili9486 driver reports a placeholder
# refresh of 0.007 Hz, and browsers pace their drawing by it: Chromium only draws
# about once a second. 30 Hz is above what the SPI bus can deliver for full frames
# (~11 fps), so drawing is never held back by it. Mode size is the panel's native
# (unrotated) size. Set empty to leave the driver's mode alone.
OUTPUT_MODE=320x480@30Hz

# UI scale. 0.75 fits more on the 480x320 panel; 1 is easier to tap.
# Use 1 for a full-screen browser/kiosk: under 0.75, Chromium sizes its window from
# the physical 480x320 and ends up covering only 3/4 of the 640x427 logical screen.
OUTPUT_SCALE=0.75

# libinput calibration matrix, used when calibration is skipped. Fitted on one
# MHS35 unit (PANEL_ROTATE=90, OUTPUT_TRANSFORM=270) by steps/03-calibrate-touch.sh:
# check-round error 0.73% of the screen (~3 px). The axes are swapped (non-zero
# off-diagonal terms): the touch layer's X/Y run the other way round from the
# display's. Resistive panels vary between units, so measure your own. Only valid
# for PANEL_ROTATE=90.
CAL_MATRIX="0.00271 1.12558 -0.04919 1.11325 0.00444 -0.06729"
